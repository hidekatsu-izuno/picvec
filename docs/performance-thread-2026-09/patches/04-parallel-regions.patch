+            for second in first + 1..parents.len() {
+                for third in second + 1..parents.len() {
+                    let entries = [parents[first], parents[second], parents[third]];
+                    if entries[0].0 == entries[1].0
+                        || entries[0].0 == entries[2].0
+                        || entries[1].0 == entries[2].0
