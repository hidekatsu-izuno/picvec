+/// Find a small residual on an otherwise accurately represented opaque region.
+/// Scan every source pixel: sampling would miss isolated lines and small marks.
+/// A uniform source collar prevents cutting a connected stroke or gradient.
+/// Alpha inputs must use the complete candidate path until RGBA residuals are
+/// available; a preview composited on one background cannot establish opacity.
+pub(crate) fn local_residual_core<S: RasterSource + ?Sized>(
+    source: &S,
+    base: &Raster,
+    base_source: SourceRect,
+    region: SourceRect,
+) -> Option<SourceRect> {
+    if region.area() < 256 * 256
+        || base.width != base_source.width
+        || base.height != base_source.height
+    {
+        return None;
+    }
+    let right = region.x + region.width;
+    let bottom = region.y + region.height;
+    let (mut x0, mut y0, mut x1, mut y1) = (right, bottom, region.x, region.y);
+    for y in region.y..bottom {
+        for x in region.x..right {
+            let actual = base.get(x - base_source.x, y - base_source.y);
+            let expected = source.get(x, y);
+            if (0..3).any(|c| (actual[c] - expected[c]).abs() > 4.0 / 255.0) {
+                x0 = x0.min(x);
+                y0 = y0.min(y);
+                x1 = x1.max(x + 1);
+                y1 = y1.max(y + 1);
+                if (x1 - x0) * (y1 - y0) > region.area() / 4 {
+                    return None;
+                }
+            }
+        }
+    }
+    if x0 >= x1 || y0 >= y1 {
+        return None;
+    }
+    // Leave enough unchanged source support for the crop and its fitted join.
+    const COLLAR: usize = 16;
+    if x0 < region.x + COLLAR
+        || y0 < region.y + COLLAR
+        || x1 + COLLAR > right
+        || y1 + COLLAR > bottom
+    {
+        return None;
+    }
+    let core = SourceRect {
+        x: x0 - COLLAR,
+        y: y0 - COLLAR,
+        width: x1 - x0 + 2 * COLLAR,
+        height: y1 - y0 + 2 * COLLAR,
+    };
+    if core.expanded(24, right, bottom).area() > region.area() / 4 {
+        return None;
+    }
+    let background = source.get(core.x, core.y);
+    // The vectorizer sees this halo too. An accurately represented neighbour
+    // there would otherwise be fitted and then hidden entirely by the crop.
+    let margin = (core.width.min(core.height) / 64).clamp(8, 24);
+    let support = core.expanded(margin, source.width(), source.height());
+    for y in support.y..support.y + support.height {
+        for x in support.x..support.x + support.width {
+            if x >= x0 && x < x1 && y >= y0 && y < y1 {
+                continue;
+            }
+            let pixel = source.get(x, y);
+            if (0..3).any(|c| (pixel[c] - background[c]).abs() > 1.0 / 255.0) {
+                return None;
+            }
+        }
+    }
+    Some(core)
+}
