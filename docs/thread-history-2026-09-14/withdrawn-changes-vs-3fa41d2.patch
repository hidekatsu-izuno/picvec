+/// Do not leave complete coarse objects hidden by a local replacement. A
+/// background face spanning the replacement remains useful outside it. If an
+/// entire old object would disappear, use the existing whole-object path.
+fn local_replacement_keeps_base_objects(
+    base: &resvg::usvg::Tree,
+    core: SourceRect,
+    source_dimensions: (usize, usize),
+) -> bool {
+    fn visit(group: &resvg::usvg::Group, bounds: [f32; 4]) -> bool {
+        group.children().iter().all(|node| match node {
+            resvg::usvg::Node::Group(group) => visit(group, bounds),
+            resvg::usvg::Node::Path(_) => node.abs_layer_bounding_box().is_none_or(|b| {
+                b.left() < bounds[0]
+                    || b.top() < bounds[1]
+                    || b.right() > bounds[2]
+                    || b.bottom() > bounds[3]
+            }),
+            _ => false,
+        })
+    }
+    let sx = base.size().width() / source_dimensions.0 as f32;
+    let sy = base.size().height() / source_dimensions.1 as f32;
+    visit(
+        base.root(),
+        [
+            core.x as f32 * sx,
+            core.y as f32 * sy,
+            (core.x + core.width) as f32 * sx,
+            (core.y + core.height) as f32 * sy,
+        ],
+    )
+}
