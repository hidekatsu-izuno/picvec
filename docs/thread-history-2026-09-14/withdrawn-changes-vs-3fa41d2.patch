+#!/usr/bin/env python3
+"""Measure adaptive changes that may intentionally produce different SVGs.
+
+Uses the same alternating, serial timing protocol as benchmark_exact.py.
+This records output differences; rendering quality must be checked separately.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import statistics
+import struct
+import zlib
+
+from benchmark_exact import CASES, run
+
+
+def sparse_detail(path: Path) -> None:
+    """Opaque panel with source-only small marks, generated without dependencies."""
+    width = height = 2048
+    pixels = bytearray(bytes((255, 255, 255)) * width * height)
+    for y in range(128, 1920):
+        pixels[(y * width + 128) * 3:(y * width + 1920) * 3] = bytes((80, 160, 224)) * 1792
+    for y in range(920, 1128):
+        for x in range(920, 1128):
+            if (y - 920) % 17 < 2 and (x - 920) % 17 < 2:
+                pixels[(y * width + x) * 3:(y * width + x + 1) * 3] = bytes((20, 30, 40))
+
+    def chunk(kind: bytes, payload: bytes) -> bytes:
+        return (struct.pack(">I", len(payload)) + kind + payload
+                + struct.pack(">I", zlib.crc32(kind + payload) & 0xffffffff))
+
+    data = b"".join(b"\0" + pixels[y * width * 3:(y + 1) * width * 3]
+                    for y in range(height))
+    path.write_bytes(b"\x89PNG\r\n\x1a\n"
+                     + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
+                     + chunk(b"IDAT", zlib.compress(data)) + chunk(b"IEND", b""))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--baseline", type=Path, required=True)
+    parser.add_argument("--candidate", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--repeats", type=int, default=3)
+    parser.add_argument("--threads", type=int, default=4)
+    parser.add_argument("--cases", nargs="+", choices=[*CASES, "sparse-large"],
+                        default=["sparse-large", "adaptive-small", "alpha", "car"])
+    args = parser.parse_args()
+    if args.repeats < 1 or args.threads < 1:
+        parser.error("repeats and threads must be positive")
+    binaries = {"baseline": args.baseline.resolve(), "candidate": args.candidate.resolve()}
+    if any(not path.is_file() for path in binaries.values()):
+        parser.error("both executables must exist")
+    output = args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    if "sparse-large" in args.cases:
+        source = output / "sparse-large.png"
+        sparse_detail(source)
+        CASES["sparse-large"] = (str(source), ["--max-dimension", "256"])
+    report = {
+        "executables": {name: {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
+                        for name, path in binaries.items()},
+        "threads": args.threads, "runs": [], "medians": {},
+    }
+    for repeat in range(args.repeats):
+        for case in args.cases:
+            order = ["baseline", "candidate"] if repeat % 2 == 0 else ["candidate", "baseline"]
+            for version in order:
+                trial = run(binaries[version], case, output / f"{case}-{repeat}-{version}.svg", args.threads, 300)
+                report["runs"].append({"case": case, "repeat": repeat, "version": version, **trial})
+                (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
+                print(case, repeat, version, round(trial["seconds"], 3),
+                      trial["summary"]["adaptive_refinement"], flush=True)
+    for case in args.cases:
+        report["medians"][case] = {
+            version: statistics.median(r["seconds"] for r in report["runs"]
+                                       if r["case"] == case and r["version"] == version)
+            for version in binaries
+        }
+    (output / "results.json").write_text(json.dumps(report, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
