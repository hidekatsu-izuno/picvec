+                        }
+                    })
+                    .collect();
+                let left = normalized(Point {
+                    x: points[1].x - points[0].x,
+                    y: points[1].y - points[0].y,
+                });
+                let last = points.len() - 1;
+                let right = normalized(Point {
+                    x: points[last - 1].x - points[last].x,
